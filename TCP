import java.net.InetSocketAddress;
import java.nio.ByteBuffer;
import java.nio.ByteOrder;
import java.nio.channels.SocketChannel;
import java.nio.charset.StandardCharsets;
import java.util.*;

/** Bài 5 - cổng 2211 - SocketChannel + ByteBuffer, frame = 4 byte độ dài (big-endian) + payload UTF-8 */
public class Bai5_SocketChannel {
    static final String HOST = "api.ptit.store";
    static final int PORT = 2211;
    static final String STUDENT_CODE = "B23DCCN517";
    static final String Q_CODE = "IaQnaHEr";          // TODO

    public static void main(String[] args) throws Exception {
        try (SocketChannel ch = SocketChannel.open(new InetSocketAddress(HOST, PORT))) {
            ch.socket().setSoTimeout(5000);

            sendFrame(ch, STUDENT_CODE + ";" + Q_CODE);

            List<Integer> ok = new ArrayList<>(), fail = new ArrayList<>(), retry = new ArrayList<>();
            for (int f = 0; f < 2; f++) {
                String frame = readFrame(ch);
                System.out.println("Frame " + (f + 1) + ": " + frame);
                for (String rec : frame.split("\\|")) {
                    rec = rec.trim();
                    if (rec.isEmpty()) continue;
                    String[] p = rec.split(",");   // id,operation,status
                    int id = Integer.parseInt(p[0].trim());
                    switch (p[2].trim().toUpperCase()) {
                        case "OK":    ok.add(id); break;
                        case "FAIL":  fail.add(id); break;
                        case "RETRY": retry.add(id); break;
                    }
                }
            }

            String result = "OK=" + join(ok) + ";FAIL=" + join(fail) + ";RETRY=" + join(retry);
            System.out.println("Gửi: " + result);
            sendFrame(ch, result);
        }
    }

    static String join(List<Integer> l) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < l.size(); i++) {
            if (i > 0) sb.append(",");
            sb.append(l.get(i));
        }
        return sb.toString();
    }

    static void sendFrame(SocketChannel ch, String payload) throws Exception {
        byte[] data = payload.getBytes(StandardCharsets.UTF_8);
        ByteBuffer bb = ByteBuffer.allocate(4 + data.length).order(ByteOrder.BIG_ENDIAN);
        bb.putInt(data.length).put(data);
        bb.flip();
        while (bb.hasRemaining()) ch.write(bb);
    }

    static String readFrame(SocketChannel ch) throws Exception {
        ByteBuffer lenBuf = ByteBuffer.allocate(4).order(ByteOrder.BIG_ENDIAN);
        readFully(ch, lenBuf);
        int len = lenBuf.getInt();
        ByteBuffer body = ByteBuffer.allocate(len);
        readFully(ch, body);
        return new String(body.array(), StandardCharsets.UTF_8);
    }

    static void readFully(SocketChannel ch, ByteBuffer bb) throws Exception {
        while (bb.hasRemaining()) {
            if (ch.read(bb) < 0) throw new java.io.EOFException("Server đóng kết nối sớm");
        }
        bb.flip();
    }
}

