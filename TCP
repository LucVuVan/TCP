import java.io.*;
import java.net.Socket;
import java.util.LinkedHashSet;
 
/** Bài 3 - cổng 2208 - BufferedReader / BufferedWriter */
public class Bai3_CharStream {
    static final String HOST = "api.ptit.store";
    static final int PORT = 2208;
    static final String STUDENT_CODE = "B23DCCN517";
    static final String Q_CODE = "iy6atec0";          // TODO
 
    public static void main(String[] args) throws Exception {
        try (Socket socket = new Socket(HOST, PORT)) {
            socket.setSoTimeout(5000);
            BufferedReader br = new BufferedReader(new InputStreamReader(socket.getInputStream()));
            BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(socket.getOutputStream()));
 
            bw.write(STUDENT_CODE + ";" + Q_CODE);
            bw.newLine();
            bw.flush();
 
            String s = br.readLine();
            System.out.println("Nhận: " + s);
 
            // Giữ chữ cái, bỏ số + ký tự đặc biệt, bỏ ký tự trùng (giữ lần xuất hiện đầu)
            LinkedHashSet<Character> set = new LinkedHashSet<>();
            for (char c : s.toCharArray()) {
                if (Character.isLetter(c)) set.add(c); // phân biệt hoa/thường
                // Nếu đề coi 'A' và 'a' là trùng: set.add(Character.toLowerCase(c));
            }
            StringBuilder sb = new StringBuilder();
            for (char c : set) sb.append(c);
 
            System.out.println("Gửi: " + sb);
            bw.write(sb.toString());
            bw.newLine();
            bw.flush();
        }
    }
}

