import java.io.*;
import java.net.Socket;
import java.nio.charset.StandardCharsets;
import java.util.*;
 
/** Bài 2 - cổng 2206 - InputStream / OutputStream */
public class Bai2_ByteStream {
    static final String HOST = "api.ptit.store";
    static final int PORT = 2206;
    static final String STUDENT_CODE = "B23DCCN517";
    static final String Q_CODE = "ODRT6vKA";          // TODO
 
    public static void main(String[] args) throws Exception {
        try (Socket socket = new Socket(HOST, PORT)) {
            socket.setSoTimeout(5000);
            InputStream in = socket.getInputStream();
            OutputStream out = socket.getOutputStream();
 
            out.write((STUDENT_CODE + ";" + Q_CODE).getBytes(StandardCharsets.UTF_8));
            out.flush();
 
            byte[] buf = new byte[65536];
            int n = in.read(buf);
            while (in.available() > 0) { // đọc nốt phần còn lại nếu có
                int more = in.read(buf, n, buf.length - n);
                if (more < 0) break;
                n += more;
            }
            String data = new String(buf, 0, n, StandardCharsets.UTF_8).trim();
            System.out.println("Nhận: " + data);
 
            List<Integer> even = new ArrayList<>(), odd = new ArrayList<>();
            for (String s : data.split(",")) {
                s = s.trim();
                if (s.isEmpty()) continue;
                int v = Integer.parseInt(s);
                if (v % 2 == 0) even.add(v); else odd.add(v);
            }
            Collections.sort(even);
            Collections.sort(odd);
 
            String result = even + ";" + odd; // [2, 4, 6, 8, 10];[1, 3, 7, 15]
            System.out.println("Gửi: " + result);
            out.write(result.getBytes(StandardCharsets.UTF_8));
            out.flush();
        }
    }
}

