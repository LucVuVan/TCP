public class Bai1_CustomerClient {
    static final String HOST = "api.ptit.store";
    static final int PORT = 2209;
    static final String STUDENT_CODE = "B23DCCN517";
    static final String Q_CODE = "F2DA54F3"; // TODO: đổi thành mã câu hỏi của bạn
 
    public static void main(String[] args) throws Exception {
        try (Socket socket = new Socket(HOST, PORT)) {
            socket.setSoTimeout(5000);
            ObjectOutputStream oos = new ObjectOutputStream(socket.getOutputStream());
            oos.flush();
            ObjectInputStream ois = new ObjectInputStream(socket.getInputStream());
 
            // 1) Gửi studentCode;qCode
            oos.writeObject(STUDENT_CODE + ";" + Q_CODE);
            oos.flush();
 
            // 2) Nhận Customer
            Customer c = (Customer) ois.readObject();
            System.out.println("Nhận: " + c);
 
            // 3) Chuẩn hóa
            String[] p = c.name.trim().toLowerCase().split("\\s+");
            c.name = normalizeName(p);
            c.dayOfBirth = normalizeDob(c.dayOfBirth);
            c.userName = makeUserName(p);
 
            oos.writeObject(c);
            oos.flush();
            System.out.println("Gửi: " + c);
            // 4) Đóng socket (try-with-resources)
        }
    }
 
    // nguyen van hai duong -> DUONG, Nguyen Van Hai
    static String normalizeName(String[] p) {
        StringBuilder sb = new StringBuilder(p[p.length - 1].toUpperCase()).append(",");
        for (int i = 0; i < p.length - 1; i++) {
            sb.append(" ").append(Character.toUpperCase(p[i].charAt(0))).append(p[i].substring(1));
        }
        return sb.toString();
    }
 
    // mm-dd-yyyy -> dd/mm/yyyy
    static String normalizeDob(String d) {
        String[] x = d.trim().split("-");
        return x[1] + "/" + x[0] + "/" + x[2];
    }
 
    // nguyen van hai duong -> nvhduong
    static String makeUserName(String[] p) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < p.length - 1; i++) sb.append(p[i].charAt(0));
        return sb.append(p[p.length - 1]).toString();
    }
}

