import java.io.*;
import java.net.Socket;
import java.util.LinkedHashMap;
import java.util.Map;
 
/** Bài 2 - cổng 2208 - BufferedReader / BufferedWriter: ký tự (chữ/số) xuất hiện > 1 lần */
public class Bai2_CharStream {
    static final String HOST = "api.ptit.store";
    static final int PORT = 2208;
    static final String STUDENT_CODE = "B23DCCN517";
    static final String Q_CODE = "XXXXXXXX"; // TODO
 
    public static void main(String[] args) throws Exception {
        try (Socket socket = new Socket(HOST, PORT)) {
            socket.setSoTimeout(5000);
            BufferedReader br = new BufferedReader(new InputStreamReader(socket.getInputStream()));
            BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(socket.getOutputStream()));
 
            bw.write(STUDENT_CODE + ";" + Q_CODE);
            bw.newLine();
            bw.flush();
 
            String s = br.readLine();
            System.out.println("Nhận: " + s);
 
            // Đếm theo thứ tự xuất hiện đầu tiên, phân biệt hoa/thường
            Map<Character, Integer> count = new LinkedHashMap<>();
            for (char c : s.toCharArray()) {
                if (Character.isLetterOrDigit(c)) count.merge(c, 1, Integer::sum);
            }
 
            // Ví dụ: d:2,O:2,o:2,2:3,
            StringBuilder sb = new StringBuilder();
            for (Map.Entry<Character, Integer> e : count.entrySet()) {
                if (e.getValue() > 1) sb.append(e.getKey()).append(":").append(e.getValue()).append(",");
            }
 
            System.out.println("Gửi: " + sb);
            bw.write(sb.toString());
            bw.newLine();
            bw.flush();
        }
    }
}

