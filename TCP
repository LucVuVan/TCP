import java.io.*;
import java.net.Socket;
import java.nio.charset.StandardCharsets;

/** Bài 3 - cổng 2206 - InputStream / OutputStream: kiểm tra gói hex có checksum */
public class Bai3_ByteRaw {
    static final String HOST = "api.ptit.store";
    static final int PORT = 2206;
    static final String STUDENT_CODE = "B23DCCN517";
    static final String Q_CODE = "XXXXXXXX"; // TODO

    public static void main(String[] args) throws Exception {
        try (Socket socket = new Socket(HOST, PORT)) {
            socket.setSoTimeout(5000);
            InputStream in = socket.getInputStream();
            OutputStream out = socket.getOutputStream();

            out.write((STUDENT_CODE + ";" + Q_CODE).getBytes(StandardCharsets.UTF_8));
            out.flush();

            byte[] buf = new byte[65536];
            int n = in.read(buf);
            while (in.available() > 0) {
                int more = in.read(buf, n, buf.length - n);
                if (more < 0) break;
                n += more;
            }
            String data = new String(buf, 0, n, StandardCharsets.UTF_8).trim();
            System.out.println("Nhận: " + data);

            int valid = 0, payloadBytes = 0;
            for (String packet : data.split("\\|")) {
                packet = packet.trim();
                if (packet.isEmpty()) continue;
                String[] b = packet.split("-");
                if (b.length < 2) continue;
                int sum = 0;
                for (int i = 0; i < b.length - 1; i++) sum += Integer.parseInt(b[i].trim(), 16);
                int checksum = Integer.parseInt(b[b.length - 1].trim(), 16);
                if (sum % 256 == checksum) {
                    valid++;
                    payloadBytes += b.length - 1;
                }
            }

            String result = "valid=" + valid + ";payloadBytes=" + payloadBytes;
            System.out.println("Gửi: " + result);
            out.write(result.getBytes(StandardCharsets.UTF_8));
            out.flush();
        }
    }
}

